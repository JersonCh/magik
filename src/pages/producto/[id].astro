---
import Layout from "../../layouts/Layout.astro"
import ProductCard from "../../components/astro/ProductCard.astro"
import ProductGallery from "../../components/react/ProductGallery"
import ProductDetailInteractive from "../../components/react/ProductDetailInteractive"
import { getProductById, getRelatedProducts, getStoreConfig } from "../../lib/db"
import { DEFAULT_WHATSAPP_NUMBER } from "@/types/domain"

export const prerender = false

const { id } = Astro.params
const productId = Number(id)

if (!Number.isInteger(productId) || productId <= 0) {
  return Astro.redirect("/catalogo")
}

const product = await getProductById(productId, Astro.locals)

if (!product || product.status === "borrador" || product.status === "archivado") {
  return Astro.redirect("/catalogo")
}

const [relatedProducts, whatsappNumber] = await Promise.all([
  getRelatedProducts(product.id, Astro.locals, 3),
  getStoreConfig("whatsapp_number", DEFAULT_WHATSAPP_NUMBER, Astro.locals),
])

const galleryImages =
  product.images && product.images.length > 0 ? product.images : [product.image]

const specLines = (product.technicalSpecs || "")
  .split(/\r?\n/)
  .map((line) => line.trim())
  .filter(Boolean)

const boxLines = (product.boxContents || "")
  .split(/\r?\n/)
  .map((line) => line.trim())
  .filter(Boolean)

const hasBoxContents = boxLines.length > 0
const eyebrowText = product.model ? `${product.brand} · ${product.model}` : product.brand
---

<Layout
  title={`${product.name} | ${product.brand} - Magik Barber Supply`}
  description={`Compra ${product.name} de ${product.brand}. S/${product.price}. Envíos y atención en Tacna.`}
  currentPath="/catalogo"
>
  <main class="page shell">
    <p class="breadcrumb">
      <a href="/">Inicio</a> / <a href={`/catalogo?categoria=${encodeURIComponent(product.category)}`}>{product.category}</a> / {product.name}
    </p>

    <div class="detail-grid">
      <ProductGallery images={galleryImages} productName={product.name} client:load />

      <section class="detail-info">
        <p class="eyebrow">{eyebrowText}</p>
        <h1>{product.name}</h1>

        <div class="detail-price">
          <strong>S/{product.price}</strong>
          {product.oldPrice && (
            <>
              <del>S/{product.oldPrice}</del>
              <span>Ahorra S/{Math.round((product.oldPrice - product.price) * 100) / 100}</span>
            </>
          )}
        </div>

        <p class={product.stock ? "stock-pill" : "stock-pill out"}>
          {product.stock ? "Disponible" : "Agotado"}
        </p>

        <p class="detail-description">
          {product.description ||
            "Producto para uso profesional o personal. Las características y disponibilidad final se confirman por WhatsApp."}
        </p>

        <ProductDetailInteractive
          product={product}
          whatsappNumber={whatsappNumber}
          client:load
        />
      </section>
    </div>

    <!-- Columnas de ficha técnica: 3 si incluye Contenido de la caja, 2 si es opcional/vacío -->
    <div class={hasBoxContents ? "detail-tabs" : "detail-tabs detail-tabs--two"}>
      <section>
        <h2>Descripción</h2>
        <p>
          {product.description ||
            "Fotografía y precio referenciales. Consulta al equipo de Magik Barber Supply para validar el modelo exacto."}
        </p>
      </section>

      <section>
        <h2>Características técnicas</h2>
        {specLines.length > 1 ? (
          <ul>
            {specLines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        ) : (
          <p>
            {specLines[0] ||
              "Especificaciones técnicas por confirmar según presentación. Escríbenos por WhatsApp para asesoría directa."}
          </p>
        )}
      </section>

      {hasBoxContents && (
        <section>
          <h2>Contenido de la caja</h2>
          {boxLines.length > 1 ? (
            <ul>
              {boxLines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          ) : (
            <p>{boxLines[0]}</p>
          )}
        </section>
      )}
    </div>

    <!-- Productos relacionados -->
    {relatedProducts.length > 0 && (
      <section class="related">
        <div class="section-heading">
          <div>
            <p>SELECCIÓN MAGIK</p>
            <h2>También te puede interesar</h2>
          </div>
        </div>
        <div class="product-grid">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
