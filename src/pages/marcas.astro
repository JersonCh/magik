---
import Layout from "../layouts/Layout.astro"
import BrandDirectory from "../components/react/BrandDirectory"
import { getBrands, getProducts } from "../lib/db"

export const prerender = false

const initialBrand = Astro.url.searchParams.get("marca") || undefined
const [products, brands] = await Promise.all([
  getProducts(Astro.locals),
  getBrands(Astro.locals),
])
---

<Layout title="Marcas | Magik Barber Supply Tacna" currentPath="/marcas">
  <main class="page shell">
    <p class="breadcrumb">
      <a href="/">Inicio</a> / Marcas
    </p>

    <div class="page-intro">
      <p>MARCAS DEL CATÁLOGO</p>
      <h1>Equipos para cada estilo de trabajo</h1>
      <span>
        La disponibilidad de marcas y modelos se confirma al coordinar por WhatsApp.
      </span>
    </div>

    <BrandDirectory
      client:load
      products={products}
      brands={brands}
      initialBrand={initialBrand}
    />
  </main>
</Layout>
