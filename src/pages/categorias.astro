---
import Layout from "../layouts/Layout.astro"
import CategoryDirectory from "../components/react/CategoryDirectory"
import { getCategories, getProducts } from "../lib/db"

export const prerender = false

const initialCategory = Astro.url.searchParams.get("categoria") || undefined
const [products, categories] = await Promise.all([
  getProducts(Astro.locals),
  getCategories(Astro.locals),
])
---

<Layout title="Categorías | Magik Barber Supply Tacna" currentPath="/categorias">
  <main class="page shell">
    <p class="breadcrumb">
      <a href="/">Inicio</a> / Categorías
    </p>

    <div class="page-intro">
      <p>LÍNEAS DEL CATÁLOGO</p>
      <h1>Una categoría para cada técnica</h1>
      <span>Explora el catálogo por tipo de herramienta o producto.</span>
    </div>

    <CategoryDirectory
      client:load
      products={products}
      categories={categories}
      initialCategory={initialCategory}
    />
  </main>
</Layout>
