---
import Layout from "../layouts/Layout.astro"
import ShippingCourierTabs from "../components/react/ShippingCourierTabs"
import { WHATSAPP_NUMBER } from "../data/products"
---

<Layout title="Contacto y Envíos | Magik Barber Supply Tacna" currentPath="/contacto">
  <main class="page shell">
    <p class="breadcrumb">
      <a href="/">Inicio</a> / Contacto y Envíos
    </p>

    <div class="contact-grid">
      <section class="contact-hero">
        <p>ESTAMOS EN TACNA</p>
        <h1>Hablemos de lo que necesitas</h1>
        <span>
          Escríbenos para consultar productos, stock y modalidades de entrega a nivel nacional.
        </span>
        <a
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hola, quisiera consultar con Magik Barber Supply sobre herramientas y envíos.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="button button--whatsapp"
        >
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z" />
            <path d="M9 8.5c.5 3 2 4.5 5 5" />
          </svg>
          Escribir por WhatsApp
        </a>
      </section>

      <section class="contact-card">
        <div>
          <span>UBICACIÓN</span>
          <b>Tacna, Perú</b>
          <p>Atención y recojo coordinado</p>
        </div>
        <div>
          <span>HORARIO</span>
          <b>Lunes a Sábado</b>
          <p>Coordinación previa por WhatsApp</p>
        </div>
        <div>
          <span>ENVÍOS NACIONALES</span>
          <b>Shalom y Olva Courier</b>
          <p>Despachos diarios a todo el Perú</p>
        </div>
        <div>
          <span>WHATSAPP DIRECTO</span>
          <b>Atención personalizada</b>
          <p>+51 900 000 000</p>
        </div>
      </section>
    </div>

    <!-- Guía y cobertura de envíos -->
    <ShippingCourierTabs client:visible />

    <section class="map-placeholder">
      <span>TACNA, PERÚ</span>
      <h2>Ubicación comercial de Magik</h2>
      <p>
        Punto de entrega en la ciudad de Tacna y despacho nacional diario.
      </p>
    </section>
  </main>
</Layout>
