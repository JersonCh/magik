---
import { WHATSAPP_NUMBER } from "../../data/products"
---

<a
  href={`https://wa.me/${WHATSAPP_NUMBER}`}
  target="_blank"
  rel="noopener noreferrer"
  class="floating-whatsapp"
  aria-label="Contactar por WhatsApp"
>
  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: white; width: 22px; height: 22px;">
    <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z" />
    <path d="M9 8.5c.5 3 2 4.5 5 5" />
  </svg>
</a>

