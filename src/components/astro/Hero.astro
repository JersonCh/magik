---
import { WHATSAPP_NUMBER } from "../../data/products"
---

<section class="hero">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="kicker">HERRAMIENTAS QUE HACEN LA DIFERENCIA</p>
      <h1>
        Potencia tu estilo con las <mark>herramientas correctas</mark>
      </h1>
      <p>
        Equipos profesionales, cuidado y accesorios para llevar cada servicio al siguiente nivel.
      </p>
      <div class="hero-actions">
        <a href="/catalogo" class="button button--primary">
          Explorar catálogo
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m-5-5 5 5-5 5" />
          </svg>
        </a>
        <a
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hola, quisiera información sobre el catálogo de Magik Barber Supply.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="button button--outline"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>

    <div class="hero-products">
      <span class="yellow-orbit"></span>
      <img
        class="hero-clipper"
        src="/assets/6bf26.png"
        alt="Cortadora profesional"
        width="280"
        height="470"
      />
      <img
        class="hero-trimmer"
        src="/assets/51ea8.png"
        alt="Trimmer profesional"
        width="190"
        height="390"
      />
      <div class="hero-note">
        <b>Todo para tu estación</b>
        <span>Equipos · Cuidado · Accesorios</span>
      </div>
    </div>
  </div>
</section>

