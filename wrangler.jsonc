{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magik-barber-supply",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magik-db",
      "database_id": "magik-local-d1-id",
      "migrations_dir": "migrations"
    }
  ]
}
